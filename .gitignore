# ── Ambiente ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
backend/loadtest/_server.log

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.code-workspace

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Documentação: ignora .md solto, mas versiona docs/ e os da raiz ───────────
*.md
!README.md
!CLAUDE.md
!docs/*.md

# ── SQL: ignora .sql solto, mas versiona as migrations/schemas em db/ ──────────
*.sql
!db/migrations/*.sql
!db/schema/*.sql
!db/test_data/*.sql

# ── Planilhas e arquivos locais ────────────────────────────────────────────────
*.xlsx
*.csv
*.png
*.jpg
*.jpeg
