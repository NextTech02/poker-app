# ── Ambiente ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
backend/loadtest/_server.log

# ── IDE / OS ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.code-workspace

# ── Logs ───────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Documentação: ignora .md solto, mas versiona docs/ e os da raiz ───────────
*.md
!README.md
!CLAUDE.md
!docs/*.md

# ── SQL: ignora .sql solto, mas versiona as migrations/schemas em db/ ──────────
*.sql
!db/migrations/*.sql
!db/schema/*.sql
!db/test_data/*.sql
# Testes de trigger num Postgres descartável (ex.: db/tests/fiado).
!db/tests/**/*.sql
# SQL que os scripts da migração do Supabase rodam (sem eles o 2_dump.sh falha).
!backend/scripts/migracao-supabase/*.sql
# Saída do roteiro E2E do fiado (ids criados em prod, por rodada).
backend/scripts/e2e_fiado_ids.json
# Copia local dos valores originais da migracao das imagens do telao (tem as
# imagens dos clubes em base64): nunca versionar.
backend/backup_imagens_do_telao_*.json
# Migração do Supabase para São Paulo: senhas/chaves (variaveis.env), a cópia do
# banco com os usuários (dump/) e as configurações exportadas. Nunca versionar,
# mesmo que os scripts sejam rodados de dentro do repositório.
**/migracao-supabase/variaveis.env
**/migracao-supabase/dump/
**/migracao-supabase/config-antigo/

# ── Planilhas e arquivos locais ────────────────────────────────────────────────
*.xlsx
*.csv
*.png
*.jpg
*.jpeg

# Exceção: imagens que fazem parte DO APP (não são prints/planilhas soltos).
# Sem isto, a regra *.png acima descarta silenciosamente os ícones do PWA e o
# app deployado deixa de ser instalável — o Chrome exige os ícones do manifest.
!frontend/public/icon-*.png
!frontend/src/assets/*.png

# Saída de execução do SonarScanner (metadados locais da última análise)
.scannerwork/

# Relatórios de cobertura (gerados a cada execução dos testes)
backend/coverage.xml
backend/.coverage
frontend/coverage/

# Saida da varredura de QA: contem auth-state.json com TOKENS DE SESSAO,
# alem de capturas e videos pesados. Nada disso deve ir para o repositorio.
dogfood-output/

# Vídeos de suporte: gravações, áudio em cache e as chaves ficam fora do git.
scripts/videos/cache/
scripts/videos/saida/
scripts/videos/__pycache__/
**/videos.env

# ── Preview visual local (backend/scripts/ui_preview_session.py, frontend/scripts/ui_shot.py) ──
backend/scripts/.ui_preview_state.json
backend/scripts/.ui_preview_url.txt
frontend/scripts/.chrome_profile/
frontend/scripts/.shots/
