# ── Copia este arquivo para .env e preencha os valores ────────────────────────

# Supabase (mesmos valores do backend/.env atual)
SUPABASE_URL=https://vhyfbjgcecyohacwajdf.supabase.co
SUPABASE_SERVICE_KEY=COLE_AQUI_O_SERVICE_KEY
SUPABASE_JWT_SECRET=COLE_AQUI_O_JWT_SECRET

# URL pública do frontend (usada no CORS do backend)
# Exemplo: https://app.seudominio.com
FRONTEND_URL=https://SUBDOMINIO_APP.seudominio.com

# URL pública da API (usada pelo frontend para chamadas axios)
# Exemplo: https://api.seudominio.com
REACT_APP_API_URL=https://SUBDOMINIO_API.seudominio.com

# Supabase anon key (chave pública, usada pelo frontend)
REACT_APP_SUPABASE_ANON_KEY=COLE_AQUI_O_ANON_KEY
