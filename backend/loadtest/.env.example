# Copy to backend/loadtest/.env and fill in. Only the test credentials are
# required — Supabase URL/anon key and the API base are read from frontend/.env
# automatically, but you can override them here.

# Test account used to log in (use a dedicated account, ideally admin or cashier).
STRESS_EMAIL=
STRESS_PASSWORD=

# Optional overrides:
# API_BASE_URL=http://localhost:8000
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# STAGE_ID=                 # pin a specific stage; otherwise the first one is used

# Set to 1 to enable WRITE load (sangi sales flow). Creates real rows —
# prefer running against a Supabase branch. Default 0 (read-only).
STRESS_WRITES=0
