# Backend — copie para backend/.env e preencha. NUNCA versione o .env.

# Projeto Supabase (Settings > API Keys)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave secreta (sb_secret_...): só no backend, ignora o RLS.
SUPABASE_SERVICE_KEY=
# Chave publicável (sb_publishable_...): o backend faz as consultas COMO o
# usuário logado com ela, e o RLS isola os clubes.
SUPABASE_ANON_KEY=
# Vazio: os tokens são validados pelo JWKS do projeto (ES256). Preencha só se o
# projeto ainda assinar com o segredo antigo (HS256).
SUPABASE_JWT_SECRET=

# Origens aceitas pelo CORS: o app e a landing.
FRONTEND_URL=http://localhost:3000
LANDING_URL=

# Ids de auth.users com acesso de super admin, separados por vírgula.
SUPER_ADMIN_USER_IDS=

# E-mails transacionais (convites, esqueci a senha, aviso de lead), via Resend.
# Vazio em desenvolvimento: o link vai para o log.
RESEND_API_KEY=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=AceBlind <noreply@aceblind.net>

# Secret do hCaptcha do "esqueci minha senha". Vazio: verificação pulada (só dev).
HCAPTCHA_SECRET=

# Interruptor de emergência do multi-clube: false volta às consultas com a chave
# secreta (sem RLS), sem precisar de deploy.
SUPABASE_RLS_AS_USER=true

# Uma linha de log por requisição, com o tempo e as idas ao banco.
PERF_LOG=false
