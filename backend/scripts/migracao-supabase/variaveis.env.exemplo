# Copie para `variaveis.env` (NÃO versionar: tem senhas e chaves) e preencha.
# Os scripts leem este arquivo da pasta atual.

# ── Projeto ANTIGO (Oregon, us-west-2) ──────────────────────────────────────
OLD_REF=kymaaegfoladwojfwxrp
OLD_URL=https://kymaaegfoladwojfwxrp.supabase.co
# Painel do projeto > Connect > "Session pooler" (funciona em IPv4). Troque
# [YOUR-PASSWORD] pela senha do banco (Database > Settings, dá para redefinir).
OLD_DB_URL=postgresql://postgres.kymaaegfoladwojfwxrp:SENHA@aws-0-us-west-2.pooler.supabase.com:5432/postgres
# Settings > API Keys > secret (ou a service_role antiga)
OLD_SERVICE_KEY=

# ── Projeto NOVO (São Paulo, sa-east-1) ─────────────────────────────────────
NEW_REF=
NEW_URL=https://NEW_REF.supabase.co
NEW_DB_URL=postgresql://postgres.NEW_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
NEW_SERVICE_KEY=

# ── Management API (copiar as configurações de Auth/API) ────────────────────
# supabase.com/dashboard/account/tokens > Generate new token. Apague depois.
SUPABASE_ACCESS_TOKEN=

# ── Segredos que a API exige para copiar o Auth e nunca devolve ─────────────
# Senha do SMTP próprio do Auth (a do projeto antigo, em Authentication >
# Emails > SMTP Settings; se o host for smtp.resend.com, é uma API key do
# Resend). Vazia: o SMTP fica para configurar à mão no painel do novo.
SMTP_PASS=
# O mesmo HCAPTCHA_SECRET do .env da VPS. Vazio: o captcha fica desligado no
# novo até ser preenchido à mão (Authentication > Attack Protection).
HCAPTCHA_SECRET=
