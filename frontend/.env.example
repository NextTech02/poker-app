# Frontend — copie para frontend/.env e preencha. NUNCA versione o .env.
# Variáveis REACT_APP_* entram no build: mudou, precisa rebuildar.

REACT_APP_API_URL=http://localhost:8000

# Projeto Supabase (Settings > API Keys): URL e a chave PUBLICÁVEL
# (sb_publishable_...). A chave secreta nunca vai para o frontend.
REACT_APP_SUPABASE_URL=https://SEU_PROJETO.supabase.co
REACT_APP_SUPABASE_ANON_KEY=

# Site key do hCaptcha (a mesma configurada em Supabase > Auth > Attack Protection).
# Vazio: usa a chave padrão definida em src/components/Captcha.js.
REACT_APP_HCAPTCHA_SITE_KEY=
