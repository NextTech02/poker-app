# Produção (VPS) — copie para .env na raiz do repositório. É ele que o
# docker-compose.yml lê. NUNCA versione o .env.
# O backend/.env e o frontend/.env da VPS seguem os .env.example de cada pasta.

# Supabase (Settings > API Keys)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_SERVICE_KEY=
# Chave publicável: vai para o build do frontend e para o backend.
REACT_APP_SUPABASE_ANON_KEY=
# Vazio: tokens validados pelo JWKS do projeto (ES256).
SUPABASE_JWT_SECRET=

# Endereços públicos
REACT_APP_API_URL=https://api.aceblind.net
FRONTEND_URL=https://app.aceblind.net
LANDING_URL=https://aceblind.net

SUPER_ADMIN_USER_IDS=

RESEND_API_KEY=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=AceBlind <noreply@aceblind.net>
# Obrigatório em produção.
HCAPTCHA_SECRET=

SUPABASE_RLS_AS_USER=true
PERF_LOG=false

# Cloudflare Tunnel (Zero Trust > Tunnels): publica os domínios sem porta aberta.
CLOUDFLARE_TUNNEL_TOKEN=
